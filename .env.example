# Local-only service
ZERO_BURN_HOST=127.0.0.1
ZERO_BURN_PORT=8787
ZERO_BURN_DB=./data/zero_burn.sqlite3
ZERO_BURN_MAX_ATTEMPTS=3
ZERO_BURN_BUDGET_UNITS=100

# Disabled by default. Set to ollama to enable local inference.
ZERO_BURN_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
ZERO_BURN_PROVIDER_TIMEOUT=60

# OPTIONAL CLOUD PROVIDER (may incur charges); never commit real keys.
# ZERO_BURN_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example/v1
# OPENAI_COMPATIBLE_MODEL=your-model
# OPENAI_COMPATIBLE_API_KEY=replace-me
